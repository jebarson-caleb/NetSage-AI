# ==============================================================================
# NetSage AI: Environment Configuration Template (.env.example)
# Copy this file to .env and configure your API keys:
#   copy .env.example .env (Windows)
#   cp .env.example .env (Linux/macOS)
# ==============================================================================

# Groq Cloud API Key (Get a free key at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection (e.g. openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b)
GROQ_MODEL=openai/gpt-oss-120b

# Default Reasoning Provider (groq | local | gemini | openai)
NETSAGE_PROVIDER=groq

# (Optional) Google Gemini API Key
# GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here

# Web Server Port (Default: 8000)
PORT=8000
